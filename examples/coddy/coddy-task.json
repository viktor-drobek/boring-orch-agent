{
  "schema_version": 1,
  "objective": "Review the configured workspace and return a JSON summary of the three highest-value improvements.",
  "runtime": "llm",
  "coddy": {
    "permission_mode": "ask",
    "stream": true
  },
  "sandbox": "read-only",
  "tools": ["list_files", "read_file"],
  "output_schema": {
    "type": "object",
    "required": ["improvements"],
    "properties": {
      "improvements": {
        "type": "array",
        "maxItems": 3,
        "items": {"type": "string"}
      }
    },
    "additionalProperties": false
  },
  "budget": {"max_steps": 8, "request_seconds": 90, "output_tokens": 1200}
}
